  "test_points": [
    {
      "id": "TP1",
      "name": "VBUS_USB",
      "type": "dc_voltage",
      "location": "Near J1 and input protection",
      "ground_reference": "TP0",
      "expected": {
        "nominal": 5,
        "unit": "V",
        "tolerance_percent": 5
      },
      "conditions": "USB-C source connected; board idle",
      "instrument": "CAT-rated DMM appropriate for the bench setup",
      "notes": "Confirms input power after the connector."
    },
    {
      "id": "TP2",
      "name": "VCC_3V3",
      "type": "dc_voltage",
      "location": "Regulator output near U3",
      "ground_reference": "TP0",
      "expected": {
        "nominal": 3.3,
        "unit": "V",
        "tolerance_percent": 3,
        "ripple_max": {
          "value": 80,
          "unit": "mVpp",
          "bandwidth": "20 MHz"
        }
      },
      "conditions": "Board powered; firmware heartbeat running",
      "instrument": "DMM for DC; oscilloscope with short ground spring for ripple",
      "notes": "Investigate droop during radio activity if resets occur."
    },
    {
      "id": "TP3",
      "name": "MCU_EN",
      "type": "digital",
      "location": "ESP32-S3 enable net",
      "ground_reference": "TP0",
      "expected": {
        "logic_family": "3V3_CMOS",
        "state": "high_after_power_on",
        "low_max": 0.3,
        "high_min": 2.7,
        "unit": "V"
      },
      "conditions": "More than 100 ms after VCC_3V3 becomes stable",
      "instrument": "DMM or oscilloscope",
      "notes": "A low level holds the MCU in reset."
    },
    {
      "id": "TP4",
      "name": "UART_TX",
      "type": "uart",
      "location": "Between U1 and U2",
      "ground_reference": "TP0",
      "expected": {
        "logic_family": "3V3_CMOS",
        "baud": 115200,
        "data_bits": 8,
        "parity": "none",
        "stop_bits": 1,
        "idle_state": "high"
      },
      "conditions": "Demo firmware running",
      "instrument": "Oscilloscope or 3.3 V logic analyzer",
      "notes": "Expected text includes the board ID and heartbeat."
    },
    {
      "id": "TP5",
      "name": "I2C_SCL",
      "type": "i2c",
      "location": "Expansion header clock line",
      "ground_reference": "TP0",
      "expected": {
        "logic_family": "3V3_CMOS",
        "frequency": {
          "nominal": 400,
          "unit": "kHz",
          "tolerance_percent": 10
        },
        "idle_state": "high"
      },
      "conditions": "I2C diagnostic firmware actively polling a peripheral",
      "instrument": "Oscilloscope or 3.3 V logic analyzer",
      "notes": "Demonstrates protocol and frequency fields; peripheral is not fitted in the concept BOM."
    }
  ],
  "test_points_verification": "design_targets_unverified",
  "known_issues": [
    {
      "id": "KI-001",
      "title": "Random reset during Wi-Fi transmit burst",
      "status": "illustrative_unverified",
      "severity": "medium",
      "affected_revisions": [
        "1.0"
      ],
      "symptom": "Board restarts intermittently when the radio begins a high-current transmit burst.",
      "possible_causes": [
        "Insufficient local bulk capacitance near the ESP32-S3 module.",
        "Excessive regulator or interconnect impedance.",
        "AP2112 thermal or transient margin not validated for the load profile."
      ],
      "test": {
        "test_point": "TP2",
        "procedure": "Observe VCC_3V3 with a short-ground oscilloscope probe while forcing repeated Wi-Fi transmissions."
      },
      "expected_result": "3.3 V within 3 percent, with ripple and droop remaining inside the validated power budget.",
      "action": "Review regulator margin, placement, decoupling network and power-plane impedance before changing parts.",
      "safety": "Use appropriate bench practices and do not short adjacent fine-pitch nodes."
    }
  ],
  "troubleshooting": {
    "id": "POWER-ON",
    "title": "Board does not power on",
    "start": "check_visual",
    "nodes": {
      "check_visual": {
        "type": "action",
        "instruction": "Disconnect power and inspect for shorts, reversed parts, debris or visible damage.",
        "next": "safe_to_power"
      },
      "safe_to_power": {
        "type": "decision",
        "question": "Is the board safe to energize with a current-limited supply?",
        "outcomes": {
          "no": "stop_unsafe",
          "yes": "measure_tp1"
        }
      },
      "stop_unsafe": {
        "type": "result",
        "status": "stop",
        "conclusion": "Do not apply power. Repair or escalate the visible fault first."
      },
      "measure_tp1": {
        "type": "measurement",
        "test_point": "TP1",
        "question": "Is VBUS_USB within 5.0 V plus or minus 5 percent?",
        "outcomes": {
          "no": "input_fault",
          "yes": "measure_tp2"
        }
      },
      "input_fault": {
        "type": "result",
        "status": "fault_found",
        "conclusion": "Check the cable, source, J1, CC resistors and input protection path."
      },
      "measure_tp2": {
        "type": "measurement",
        "test_point": "TP2",
        "question": "Is VCC_3V3 within 3.3 V plus or minus 3 percent?",
        "outcomes": {
          "no": "regulator_path",
          "yes": "measure_tp3"
        }
      },
      "regulator_path": {
        "type": "result",
        "status": "investigate",
        "conclusion": "Check U3 enable, input voltage, output short and regulator thermal condition."
      },
      "measure_tp3": {
        "type": "measurement",
        "test_point": "TP3",
        "question": "Is MCU_EN high after power-on?",
        "outcomes": {
          "no": "reset_path",
          "yes": "firmware_path"
        }
      },
      "reset_path": {
        "type": "result",
        "status": "investigate",
        "conclusion": "Inspect the enable pull-up, reset network and any supervisor circuitry."
      },
      "firmware_path": {
        "type": "result",
        "status": "continue",
        "conclusion": "Power rails and enable appear valid. Continue with UART boot logging at TP4."
      }
    }
  },
